<!DOCTYPE html>
<html lang="en">
<head>

    <%- include('./partials/head') -%>
    <title>Blog Page</title>
</head>
<body>
    <%- include('./partials/navbar') -%>
<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <div class="card shadow border-0">

                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0">Create a New Blog</h4>
                </div>

                <div class="card-body p-4">

                    <form action="/blog/add" method="POST" enctype="multipart/form-data">

                        <!-- Blog Title -->
                        <div class="mb-3">
                            <label for="title" class="form-label fw-semibold">
                                Blog Title
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="title"
                                name="title"
                                placeholder="Enter your blog title"
                                required
                            >
                        </div>

                        <!-- Blog Body -->
                        <div class="mb-3">
                            <label for="body" class="form-label fw-semibold">
                                Blog Content
                            </label>

                            <textarea
                                class="form-control"
                                id="body"
                                name="body"
                                rows="7"
                                placeholder="Write your blog content here..."
                                required
                            ></textarea>
                        </div>

                        <!-- Cover Image URL -->
                        <div class="mb-4">
                            <label for="coverImgUrl" class="form-label fw-semibold">
                                Cover Image URL
                            </label>

                            <input
                                type="file"
                                class="form-control"
                                id="coverImgUrl"
                                name="coverImgUrl"
                                placeholder="https://example.com/image.jpg"
                            >

                            <div class="form-text">
                                Paste the URL of your blog cover image.
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4">
                                Publish Blog
                            </button>

                            <a href="/" class="btn btn-outline-secondary px-4">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>





   <%- include('./partials/scripts') -%> 
</body>
</html>